// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id             String      @id @default(uuid())
  email          String      @unique
  name           String?
  passwordHash   String 
  authProvider   AuthProvider @default(EMAIL) 
  interviews     Interview[] 
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
} 

enum AuthProvider {
  EMAIL
  GOOGLE
}

model Interview {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])  
  githubUsername  String?
  githubMetadata Json?
  jdSummary      String?
  resumeSummary  String?
  resumeUrl      String?
  jdUrl          String?
  systemPrompt   String
  voiceId        String          @default("JBFqnCBsd6RMkjVDRZzb")
  interviewType  InterviewType   @default(Technical)
  status         InterviewStatus @default(Inprogress)
  score          Int             @default(0)
  report         Json?
  messages       Message[]
  createdAt      DateTime        @default(now())

  @@index([userId, createdAt])  // dashboard listing
}

model Message {
  id          String      @id @default(uuid())
  interviewId String
  interview   Interview   @relation(fields: [interviewId], references: [id])
  role        MessageRole
  content     String
  createdAt   DateTime    @default(now())

  @@index([interviewId, createdAt])  // transcript queries
}

enum MessageRole {
  Interviewee
  Interviewer
}

enum InterviewType {
  Technical
  HR
}

enum InterviewStatus {
  Pending
  Inprogress
  Completed
}